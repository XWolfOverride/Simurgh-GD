// Construye la tabla de sintaxsis
process BuildSyntax();
begin
SynColor[00]=cReserved  = rgb(255,255,255);
SynColor[01]=cFunction  = rgb(215,215,215);
SynColor[02]=cVarType   = rgb(221,221,187);
SynColor[03]=cFenixConst= rgb(170,170,238);
SynColor[04]=cBugFunct  = rgb(255,100,100);
SynColor[05]=cFenixVar  = rgb(221,170,187);
SynColor[06]=cFenixLocal= rgb(153,221,153);
SynColor[07]=cDllFunc   = rgb(210,210,150);
SynColor[08]=cSymbol    = rgb(255,128,000);
SynColor[09]=cComment   = rgb(130,130,130);
SynColor[10]=cString    = rgb(000,255,000);
SynColor[11]=cCode      = rgb(255,255,000);
end;

// retorna el color de una palabra
Process WordColor(String S);
begin
S=" "+ucase(s)+" ";
For (x=0;x<=9;x++);
 If (Find(Syntax[x],S)>=0)
  Return(SynColor[x]);
 End;
End;
Return(cCode);
End;

// retorna el tipo de un caracter
process CharType(a)
begin
Hint=Ucase(chr(a));
for (x=0;x<5;x++)
 if (Find(CharTypes[x],Hint)>=0)
  return(x);
 end;
end;
Return (-1);
end;
